# Get your key from https://console.anthropic.com/settings/keys
# Never put a real key in this file.
ANTHROPIC_API_KEY=

# Optional. Defaults to Claude Sonnet.
CLAUDE_MODEL=claude-sonnet-4-5

# Server
PORT=3001

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:8081,http://localhost:4173,https://miniarts-sen.vercel.app,https://miniarts-steps--bo374d0y85.expo.app
